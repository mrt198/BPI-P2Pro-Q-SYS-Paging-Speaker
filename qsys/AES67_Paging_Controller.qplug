-- Q-SYS Designer Plugin: AES67 PoE Paging Controller & Zone Publisher
-- Target Hardware: Armbian SBC / BananaPi BPI-P2Pro PoE Paging Speakers
-- Protocol: UDP Multicast Announcement (239.255.77.67:7767) + TCP Control Server (7768)

PluginInfo = {
  Name = "AES67 Paging~SBC Zone Controller",
  Version = "1.4.0",
  BuildVersion = "1.4.0.12",
  Id = "7f3c91a4-2e8b-4c61-9a40-bpi2pro7767",
  Author = "Venue AV Engineering",
  Description = "Publishes Q-SYS Zone stream presets, default settings, and real-time Stage/All Call circuit triggers to Armbian/BananaPi BPI-P2Pro AES67 paging speakers.",
  ShowDebug = true
}

function GetColor(props)
  return { 37, 99, 235 }
end

function GetPrettyName(props)
  return "AES67 Paging Zone Controller v" .. PluginInfo.Version
end

function GetProperties()
  return {
    { Name = "Zone Count", Type = "integer", Min = 1, Max = 16, Value = 5 },
    { Name = "Multicast Address", Type = "string", Value = "239.255.77.67" },
    { Name = "UDP Announcement Port", Type = "integer", Min = 1024, Max = 65535, Value = 7767 },
    { Name = "TCP Sync Port", Type = "integer", Min = 1024, Max = 65535, Value = 7768 },
    { Name = "Network Interface", Type = "string", Value = "LAN A" },
    { Name = "Announcement Interval (s)", Type = "double", Min = 0.2, Max = 10.0, Value = 1.0 }
  }
end

